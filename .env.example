# Copy to .env  ->  cp .env.example .env
# These values match the fictional store seeded by docker/ (fixed demo key, read-only).
# For a real store: WooCommerce > Settings > Advanced > REST API > Add key (permissions: Read).

WOO_BASE_URL=http://localhost:8080
WOO_CONSUMER_KEY=ck_0123456789abcdef0123456789abcdef01234567
WOO_CONSUMER_SECRET=cs_fedcba9876543210fedcba9876543210fedcba98

# auto = Basic auth on https, OAuth1 signing on http (WooCommerce rejects Basic over plain http)
WOO_AUTH=auto

# client-side throttle + retries (see src/woo_connector/ratelimit.py)
WOO_RPS=5
WOO_BURST=10
WOO_TIMEOUT=15
WOO_MAX_RETRIES=4
